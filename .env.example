# Only needed for the legacy ETL / export scripts (z_util.connect_gcp and archive/).
# The dashboard itself reads returns.parquet and needs none of these.
# URL-encode special characters in passwords (e.g. @ -> %40).

# PostgreSQL warehouse (database optionsDB)
gcp_username=
gcp_password=
gcp_server=host:5432

# Azure MySQL source (database source), used by archive/python_ETL_ts.py and archive/azure_table_check.py
azure_username=
azure_password=
azure_server=host:3306
